== data
database      example_com_production
database_user example_com@10.0.0.4 → example_com_production

== services
service       fail2ban.service enabled active
service       mariadb.service enabled active
service       nftables.service enabled active

== exec
exec          swapfile: /bin/sh -c set -e
if [ ! -e /swapfile ] && [ -z "$(swapon --noheadings --show=NAME)" ]; then
  mem=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo); s=$(( mem < 2048 ? mem : 2048 )); [ "$s" -ge 512 ] || s=512; size="${s}M"
  fallocate -l "$size" /swapfile
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
fi
if [ -e /swapfile ]; then systemctl enable --now swapfile.swap; fi

