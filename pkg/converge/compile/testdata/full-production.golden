== certs
cert          example.com letsencrypt [example.com www.example.com]
              ↳ reload nginx.service (check: nginx -t)
cert          shop.example.com letsencrypt [shop.example.com]
              ↳ reload nginx.service (check: nginx -t)

== data
database      example_com_production
database      shop_example_com_production
database_user example_com@localhost → example_com_production
database_user shop_example_com@localhost → shop_example_com_production

== services
service       example-actions.service enabled active
service       fail2ban.service enabled active
service       mariadb.service enabled active
service       meilisearch.service active
service       nftables.service enabled active
service       nginx.service enabled active
service       php8.4-fpm.service enabled active
service       redis-server.service enabled active
service       wp-cron-example-com.timer enabled active
service       wp-cron-shop-example-com.timer enabled active

== exec
exec          swapfile: /bin/sh -c set -e
if [ ! -e /swapfile ] && [ -z "$(swapon --noheadings --show=NAME)" ]; then
  mem=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo); s=$(( mem < 2048 ? mem : 2048 )); [ "$s" -ge 512 ] || s=512; size="${s}M"
  fallocate -l "$size" /swapfile
  chmod 600 /swapfile
  mkswap /swapfile >/dev/null
fi
if [ -e /swapfile ]; then systemctl enable --now swapfile.swap; fi

exec          user:fc-cache-f: /bin/sh -c fc-cache -f
exec          user:tailscale-up: /bin/sh -c tailscale up --auth-key="$TS_AUTHKEY" --ssh=false
