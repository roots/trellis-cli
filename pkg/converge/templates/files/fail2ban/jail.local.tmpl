# Managed by Trellis.
[DEFAULT]
banaction = nftables-multiport
banaction_allports = nftables-allports
backend = systemd
bantime = 1h
findtime = 10m
maxretry = 6
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
{{- if .Web }}

[wordpress-wp-login]
enabled = {{ .WPLogin }}
backend = auto
filter = wordpress-wp-login
port = http,https
logpath = /srv/www/*/logs/access.log

[wordpress-xmlrpc]
enabled = {{ .XMLRPC }}
backend = auto
filter = wordpress-xmlrpc
port = http,https
logpath = /srv/www/*/logs/access.log
{{- end }}
