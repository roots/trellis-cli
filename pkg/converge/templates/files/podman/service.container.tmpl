# Managed by Trellis.
[Unit]
Description=Trellis service {{ .Name }}

[Container]
ContainerName={{ .Name }}
Image={{ .Image }}
{{- range .Service.Publish }}
PublishPort={{ . }}
{{- end }}
{{- range .Service.Volumes }}
Volume={{ . }}
{{- end }}
{{- if .Service.Env }}
EnvironmentFile={{ .EnvFile }}
{{- end }}
{{- if .Service.Memory }}
PodmanArgs=--memory={{ .Service.Memory }}
{{- end }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
