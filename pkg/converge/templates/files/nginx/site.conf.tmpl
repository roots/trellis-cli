# Managed by Trellis. Add server-level config in server/nginx/sites/{{ .Site.Name }}/.
{{- $root := printf "/srv/www/%s" .Site.Name }}
{{- if .SSL }}
server {
  listen 80;
  listen [::]:80;
  server_name {{ join .Site.Domains " " }}{{ if .Subdomains }} *.{{ .Site.Domain }}{{ end }};
  location ^~ /.well-known/acme-challenge/ {
    root /srv/www/acme;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}
{{- end }}
{{- range .Site.Redirects }}

server {
  listen {{ if $.SSL }}443 ssl{{ else }}80{{ end }};
  listen [::]:{{ if $.SSL }}443 ssl{{ else }}80{{ end }};
  server_name {{ . }};
{{- if $.SSL }}
  ssl_certificate     {{ $.CertPath }};
  ssl_certificate_key {{ $.KeyPath }};
{{- end }}
  location ^~ /.well-known/acme-challenge/ {
    root /srv/www/acme;
  }
  location / {
    return 301 {{ $.Scheme }}://{{ $.Site.Domain }}$request_uri;
  }
}
{{- end }}

server {
  listen {{ if .SSL }}443 ssl{{ else }}80{{ end }};
  listen [::]:{{ if .SSL }}443 ssl{{ else }}80{{ end }};
  http2 on;
  server_name {{ .Site.Domain }}{{ if .Subdomains }} *.{{ .Site.Domain }}{{ end }};

  access_log {{ $root }}/logs/access.log main;
  error_log  {{ $root }}/logs/error.log;

  root  {{ $root }}/current/web;
  index index.php index.htm index.html;
  charset utf-8;
  client_max_body_size {{ .ClientMaxBodySize }};
  # Server-level headers apply to every location below; a location (or
  # drop-in) that sets its own add_header must repeat these.
  add_header Fastcgi-Cache $upstream_cache_status;
  add_header X-Cache-Enabled $loopback_header_x_cache_enabled;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Content-Security-Policy "frame-ancestors 'self'" always;
  add_header Access-Control-Allow-Origin $cors;
  # Long browser cache lifetimes are opt-in (as in Trellis): add
  # `expires $expires;` in server/nginx/sites/{{ .Site.Name }}/.
{{- if .Development }}
  sendfile off;
{{- end }}
{{- if .SSL }}

  ssl_certificate     {{ .CertPath }};
  ssl_certificate_key {{ .KeyPath }};
{{- if not .SelfSigned }}
  add_header Strict-Transport-Security "max-age=31536000" always;
{{- end }}
{{- end }}
{{- if .FastCGICache }}

  set $skip_cache 0;
  if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
  if ($query_string != "") { set $skip_cache 1; }
  if ($request_uri ~* "/wp-admin/|/wp-json/|/xmlrpc.php|wp-.*.php|/feed/|index.php|sitemap(_index)?.xml") { set $skip_cache 1; }
  if ($http_cookie ~* "comment_author|wordpress_[a-f0-9]+|wp-postpass|wordpress_no_cache|wordpress_logged_in|woocommerce_items_in_cart") { set $skip_cache 1; }
{{- end }}
{{- if .Site.Multisite.Enabled }}

{{- if .Subdomains }}
  rewrite ^/(wp-.*.php)$ /wp/$1 last;
  rewrite ^/(wp-(content|admin|includes).*) /wp/$1 last;
{{- else }}
  if (!-e $request_filename) {
    rewrite /wp-admin$ $scheme://$host$request_uri/ permanent;
    rewrite ^(/[^/]+)?(/wp-.*) /wp$2 last;
    rewrite ^(/[^/]+)?(/.*\.php) /wp$2 last;
  }
{{- end }}
{{- end }}

  location ^~ /.well-known/acme-challenge/ {
    root /srv/www/acme;
  }

  include includes.d/{{ .Site.Name }}/*.conf;

  location ~* /app/uploads/.*\.php$ { deny all; }
  location ~* /app/cache/.*\.php$ { deny all; }
  location ~* \.(blade\.php|twig)$ { deny all; }
  location ~* composer\.(json|lock)$ { deny all; }
  location ~* package(-lock)?\.json$ { deny all; }
  location ~* yarn\.lock$ { deny all; }
  location ~* /\.(?!well-known\/) { deny all; }
  # Backups, dumps, logs and editor swap files left in the web root.
  location ~* (?:\.(?:bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$ { deny all; }
  # Plugin and theme readmes reveal versions.
  location ~* /app/(plugins|mu-plugins|themes)/.+\.(txt|md)$ { deny all; }
{{- if not .Site.XMLRPC }}
  # Any path, including Bedrock's /wp/xmlrpc.php.
  location ~* xmlrpc\.php$ { return 444; }
{{- end }}

  location / {
    try_files $uri $uri/ /index.php?$args;
  }

  location ~ \.php$ {
    # Missing .php files get WordPress's own 404 page.
    try_files $uri /index.php;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
    fastcgi_param DOCUMENT_ROOT $realpath_root;
    # The requested host (only this server's names reach this block); the
    # first server_name is wrong for wildcard and multisite names.
    fastcgi_param SERVER_NAME $host;
    fastcgi_pass unix:/run/php/{{ .Site.Name }}.sock;
{{- if .FastCGICache }}
    fastcgi_cache wordpress;
    fastcgi_cache_valid 200 30s;
    fastcgi_cache_bypass $skip_cache;
    fastcgi_no_cache $skip_cache;
{{- end }}
  }
}
