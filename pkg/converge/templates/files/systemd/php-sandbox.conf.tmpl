# Sandbox for code that runs WordPress (PHP-FPM and WP-Cron). WordPress
# and its plugins can't reach home directories (SSH keys, shell startup
# files, the deploy agent), use sudo, or write system directories. Files
# under /srv/www and /tmp work exactly as before.
ProtectHome=yes
ProtectSystem=full
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
